variant: fcos
version: 1.6.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ${SSH_PUBKEY}

storage:
  directories:
    - path: /etc/samba

  files:
    # SMB credentials for Hetzner Storage Box
    - path: /etc/samba/fleet-credentials
      mode: 0600
      contents:
        inline: |
          username=${SMB_USERNAME}
          password=${SMB_PASSWORD}

    # IRC config for the sidecar
    - path: /etc/claudebernetes/irc.env
      mode: 0644
      contents:
        inline: |
          IRC_SERVER=${IRC_SERVER}
          IRC_PORT=${IRC_PORT}
          IRC_PASSWORD=${IRC_PASSWORD}

systemd:
  units:
    # SMB mount for /var/mnt/fleet (FCOS: /mnt → /var/mnt)
    - name: var-mnt-fleet.mount
      enabled: true
      contents: |
        [Unit]
        Description=Mount fleet SMB share
        After=network-online.target
        Wants=network-online.target

        [Mount]
        What=//${SMB_SERVER}/${SMB_SHARE}
        Where=/var/mnt/fleet
        Type=cifs
        Options=credentials=/etc/samba/fleet-credentials,uid=1000,gid=1000,vers=3.0,_netdev

        [Install]
        WantedBy=multi-user.target

    # Node init — runs once at boot before the agent starts
    # SMB doesn't support symlinks or FIFOs, so:
    #   - credentials are copied (not symlinked) to the node's .claude/
    #   - the IRC named pipe lives on local tmpfs at /run/claudebernetes/
    - name: claudebernetes-init.service
      enabled: true
      contents: |
        [Unit]
        Description=Initialize Claudebernetes node directory
        After=var-mnt-fleet.mount
        Requires=var-mnt-fleet.mount

        [Service]
        Type=oneshot
        RemainAfterExit=yes
        User=core
        ExecStart=/bin/bash -c '\
          mkdir -p /var/mnt/fleet/nodes/%H/.claude && \
          cp /var/mnt/fleet/auth/.credentials.json /var/mnt/fleet/nodes/%H/.claude/.credentials.json && \
          cp /var/mnt/fleet/auth/settings.json /var/mnt/fleet/nodes/%H/.claude/settings.json && \
          mkdir -p /run/claudebernetes && \
          mkfifo /run/claudebernetes/irc.pipe && \
          echo "{\"status\":\"booted\",\"ts\":\"$(date -Iseconds)\"}" > /var/mnt/fleet/nodes/%H/heartbeat.json'

        [Install]
        WantedBy=multi-user.target

    # IRC sidecar — persistent IRC connection
    - name: claudebernetes-irc.service
      enabled: true
      contents: |
        [Unit]
        Description=Claudebernetes IRC sidecar
        After=claudebernetes-init.service var-mnt-fleet.mount
        Requires=var-mnt-fleet.mount
        Wants=claudebernetes-init.service

        [Service]
        Type=simple
        User=core
        EnvironmentFile=/etc/claudebernetes/irc.env
        ExecStart=/var/mnt/fleet/bin/irc-bot.sh
        Restart=always
        RestartSec=10s

        [Install]
        WantedBy=multi-user.target

    # Agent daemon — runs Claude Code in a loop
    - name: claudebernetes-agent.service
      enabled: true
      contents: |
        [Unit]
        Description=Claudebernetes agent daemon
        After=claudebernetes-init.service claudebernetes-irc.service var-mnt-fleet.mount
        Requires=var-mnt-fleet.mount
        Wants=claudebernetes-init.service claudebernetes-irc.service

        [Service]
        Type=simple
        User=core
        Environment=HOME=/var/mnt/fleet/nodes/%H
        WorkingDirectory=/var/mnt/fleet
        ExecStart=/var/mnt/fleet/bin/agent-wrapper.sh
        Restart=always
        RestartSec=30s

        [Install]
        WantedBy=multi-user.target
